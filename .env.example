# Copy to .env (never commit .env). In production every *_SECRET is REQUIRED (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=4000

SESSION_SECRET=
FORM_TOKEN_SECRET=
IP_HASH_SECRET=

# SQLite file (relative to server/)
DB_PATH=data/enquiries.db

# Set to the number of trusted reverse proxies in front of the app (0 = none, use socket IP)
TRUST_PROXY=0

# Seed accounts (fictional). If empty, `npm run seed` generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# AI provider: "mock" (default, no network) or "http" (stub adapter - not enabled for the assessment)
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_TIMEOUT_MS=10000
